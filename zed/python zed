{
  "tasks": {
    "run": {
      "name": "Run Python",
      "command": "python3",
      "args": ["src/main.py"],
      "cwd": "${workspaceFolder}"
    },
    "run-current": {
      "name": "Run Current File",
      "command": "python3",
      "args": ["${ZED_FILE}"],
      "cwd": "${workspaceFolder}"
    },
    "run-module": {
      "name": "Run Module",
      "command": "python3",
      "args": ["-m", "src.main"],
      "cwd": "${workspaceFolder}"
    },
    "install-requirements": {
      "name": "Install Requirements",
      "command": "pip",
      "args": ["install", "-r", "requirements.txt"],
      "cwd": "${workspaceFolder}"
    },
    "test": {
      "name": "Run Tests",
      "command": "python3",
      "args": ["-m", "pytest", "tests/"],
      "cwd": "${workspaceFolder}"
    },
    "test-verbose": {
      "name": "Run Tests Verbose",
      "command": "python3",
      "args": ["-m", "pytest", "-v", "tests/"],
      "cwd": "${workspaceFolder}"
    },
    "lint": {
      "name": "Lint with Ruff",
      "command": "ruff",
      "args": ["check", "src/"],
      "cwd": "${workspaceFolder}"
    },
    "format": {
      "name": "Format with Black",
      "command": "black",
      "args": ["src/"],
      "cwd": "${workspaceFolder}"
    },
    "type-check": {
      "name": "Type Check",
      "command": "mypy",
      "args": ["src/"],
      "cwd": "${workspaceFolder}"
    },
    "jupyter": {
      "name": "Run Jupyter",
      "command": "jupyter",
      "args": ["notebook"],
      "cwd": "${workspaceFolder}"
    }
  }
}
