{
  "tasks": {
    "run": {
      "name": "Run Java",
      "command": "java",
      "args": ["-cp", "bin", "Main"],
      "cwd": "${workspaceFolder}"
    },
    "build": {
      "name": "Build Java",
      "command": "javac",
      "args": ["-d", "bin", "src/**/*.java"],
      "cwd": "${workspaceFolder}"
    },
    "build-and-run": {
      "name": "Build & Run",
      "command": "sh",
      "args": ["-c", "javac -d bin src/**/*.java && java -cp bin Main"],
      "cwd": "${workspaceFolder}"
    }
  }
}
