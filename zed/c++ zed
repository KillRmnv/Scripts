{
  "tasks": {
    "build": {
      "name": "Build C++",
      "command": "g++",
      "args": ["-std=c++20", "-Wall", "-Wextra", "-o", "bin/main", "src/main.cpp"],
      "cwd": "${workspaceFolder}"
    },
    "build-all": {
      "name": "Build All C++",
      "command": "g++",
      "args": ["-std=c++20", "-Wall", "-Wextra", "-o", "bin/main", "src/*.cpp"],
      "cwd": "${workspaceFolder}"
    },
    "run": {
      "name": "Run C++",
      "command": "./bin/main",
      "cwd": "${workspaceFolder}"
    },
    "build-and-run": {
      "name": "Build & Run C++",
      "command": "sh",
      "args": ["-c", "g++ -std=c++20 -Wall -Wextra -o bin/main src/*.cpp && ./bin/main"],
      "cwd": "${workspaceFolder}"
    },
    "debug-build": {
      "name": "Debug Build C++",
      "command": "g++",
      "args": ["-std=c++20", "-g", "-O0", "-o", "bin/main_debug", "src/*.cpp"],
      "cwd": "${workspaceFolder}"
    },
    "clean": {
      "name": "Clean C++",
      "command": "rm",
      "args": ["-rf", "bin/*"],
      "cwd": "${workspaceFolder}"
    },
    "cmake-build": {
      "name": "CMake Build",
      "command": "cmake",
      "args": ["--build", "build"],
      "cwd": "${workspaceFolder}"
    },
    "cmake-configure": {
      "name": "CMake Configure",
      "command": "cmake",
      "args": ["-B", "build", "-S", "."],
      "cwd": "${workspaceFolder}"
    }
  }
}
